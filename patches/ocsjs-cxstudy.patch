-async function watchFile(pptReadPeriod: number) {
-	const vue = getPPTVueBindElement();
-	if (!vue) {
-		return;
-	}
-
-	while (true) {
-		const [current, total] =
-			document
-				.querySelector('.preview .page')
-				?.textContent?.trim()
-				// 旧版PPT任务，新版没有上一页和下一页
-				.replace('上一页', '')
-				.replace('下一页', '')
-				.split('/')
-				.map((i) => parseInt(i.trim())) || [];
-		if (!current || !total) {
-			break;
-		}
-		if (current >= total) {
-			break;
-		}
-		// 旧版PPT任务，新版使用 skip
-		try {
-			vue.next && vue.next();
-		} catch {}
-		try {
-			vue.skip && vue.skip();
-		} catch {}
-
-		await $.sleep(pptReadPeriod * 1000);
-	}
-}

+ * 浏览器环境模拟由 tests/setup-browser-env.cjs 通过 `tsx --require` 预加载，
  * 不能在本文件内 require('browser-env')：ES import 会被提升到 require 之前执行，
  * 导致 easy-us 顶层 `class IElement extends HTMLElement` 先于 HTMLElement 注册而崩溃。
  */
diff --git a/tests/cx-model.handler.test.ts b/tests/cx-model.handler.test.ts
new file mode 100644
index 0000000..f5f68c1
--- /dev/null
+++ b/tests/cx-model.handler.test.ts
@@ -0,0 +1,179 @@
+/**
+ * 模型 prompt 构造器测试
+ *
+ * pnpm test                                         运行全部
+ * pnpm exec tsx tests/cx-model.handler.test.ts      只跑本文件
+ *
+ * 背景：`buildModelAnswererWrappers` 产出的 `data.messages.handler` 是一段**字符串源码**，
+ * 运行期由 OCS 以 `Function(源码)()` 求值成函数再调用。这意味着：
+ *   1. 语法/引用错误在 tsc 阶段**查不出来**（它只是一段字符串）；
+ *   2. 只有真正把这段字符串求值并调用，才能发现问题。
+ *
+ * 本文件把 handler 求值后，用各种 env 真实调用一遍。
+ * 它守住的典型缺陷：handler 里引用了作用域外的变量（如把 `work.ts` 的局部变量
+ * 当成环境字段用），此时「图片题」一进入该分支就抛 ReferenceError，整道题答不了，
+ * 而纯文字题因 `images.length === 0` 走不到那一行，长期不会暴露。
+ */
+
+import { buildModelAnswererWrappers } from '../packages/scripts/src/utils/cx-model';
+
+let pass = 0;
+const failures: string[] = [];
+
+function ok(name: string, cond: boolean, detail?: string) {
+	if (cond) {
+		pass++;
+		console.log('  ✅ ' + name);
+	} else {
+		failures.push(name + (detail ? ' —— ' + detail : ''));
+		console.log('  ❌ ' + name + (detail ? ' —— ' + detail : ''));
+	}
+}
+
+/** 与 OCS 运行期一致的求值方式 */
+function makeHandler(debug: boolean, vision: boolean): (env: any) => any {
+	const wrappers = buildModelAnswererWrappers('opencode-go', 'fake-key-for-test', debug, vision);
+	if (!wrappers.length) throw new Error('未产出答题器（apiKey 为空？）');
+	const src = (wrappers[0] as any).data.messages.handler as string;
+	if (typeof src !== 'string' || !src.includes('function')) throw new Error('handler 不是源码字符串');
+	return new Function(src)();
+}
+
+/** 调用 handler 并把抛出的异常收成可断言的结果 */
+function call(handler: (env: any) => any, env: any): { ok: boolean; out?: any; err?: string } {
+	try {
+		return { ok: true, out: handler(env) };
+	} catch (e: any) {
+		return { ok: false, err: String((e && e.message) || e) };
+	}
+}
+
+const DATA_URL_A = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUg==';
+const DATA_URL_B = 'data:image/png;base64,iVBORw0KGgoBBBANSUhEUg==';
+const DATA_URL_C = 'data:image/png;base64,iVBORw0KGgoCCCANSUhEUg==';
+
+console.log('\n=== ① 纯文字题（此前唯一被走到的路径） ===');
+{
+	const h = makeHandler(false, true);
+	const r = call(h, {
+		type: 'single',
+		title: '内在主义是关于（）的理论。',
+		options: 'A. 信念\nB. 真理\nC. 观念\nD. 逻辑',
+		images: []
+	});
+	ok('不抛异常', r.ok, r.err);
+	const msgs = r.out || [];
+	const user = msgs[1] && msgs[1].content;
+	ok('user.content 是纯字符串（无图片时不发多模态块）', typeof user === 'string', typeof user);
+	ok('含题干', typeof user === 'string' && user.includes('内在主义'));
+	ok('含带标号选项 A.', typeof user === 'string' && user.includes('A. 信念'));
+}
+
+console.log('\n=== ② 图片题：题干与选项都是图片（D1 崩溃的复现场景） ===');
+{
+	const h = makeHandler(false, true);
+	const r = call(h, {
+		type: 'single',
+		title: DATA_URL_A,
+		options: ' ' + DATA_URL_B + ' \n ' + DATA_URL_C + ' ',
+		images: [DATA_URL_A, DATA_URL_B, DATA_URL_C],
+		// 上游 answerer-env 在有图片时给出的占位符版文本
+		suggestion_title: '[图片1]',
+		suggestion_options: '[图片2]\n[图片3]'
+	});
+	ok('★ 不抛异常（这正是 shot is not defined 的复现点）', r.ok, r.err);
+	const msgs = r.out || [];
+	const user = msgs[1] && msgs[1].content;
+	ok('user.content 是多模态块数组', Array.isArray(user), typeof user);
+	if (Array.isArray(user)) {
+		const imgs = user.filter((c: any) => c.type === 'image_url');
+		ok('图片块数与 env.images 一致（3）', imgs.length === 3, String(imgs.length));
+		ok('text 块在最前', user[0] && user[0].type === 'text');
+		const txt = (user[0] && user[0].text) || '';
+		ok('题干用了 [图片N] 占位符而非原始 URL', txt.includes('[图片1]'), txt.slice(0, 80));
+		ok('选项用了 [图片N] 占位符', txt.includes('[图片2]') && txt.includes('[图片3]'));
+		ok('未把原始 URL 混进正文', !txt.includes('data:image'), txt.slice(0, 80));
+		ok('说明图片按序附后', txt.includes('按 [图片N] 顺序附后'));
+	}
+}
+
+console.log('\n=== ③ 截图兜底：env.screenshot 必须真的发出去（D2） ===');
+{
+	const h = makeHandler(false, true);
+	const r = call(h, {
+		type: 'single',
+		title: '[图片1]',
+		options: '[图片2]\n[图片3]',
+		images: [DATA_URL_A, DATA_URL_B],
+		suggestion_title: '[图片1]',
+		suggestion_options: '[图片2]\n[图片3]',
+		screenshot: DATA_URL_C
+	});
+	ok('不抛异常', r.ok, r.err);
+	const user = (r.out && r.out[1] && r.out[1].content) || [];
+	const imgs = Array.isArray(user) ? user.filter((c: any) => c.type === 'image_url') : [];
+	ok('截图被作为最后一张图发出（2 + 1 = 3）', imgs.length === 3, String(imgs.length));
+	ok('最后一张正是 screenshot', imgs.length === 3 && imgs[2].image_url.url === DATA_URL_C);
+	const txt = Array.isArray(user) && user[0] ? user[0].text : '';
+	ok('文案说明最后一张是没有 [图片N] 的整图截图', txt.includes('整图截图'), txt.slice(0, 100));
+}
+
+console.log('\n=== ④ 关闭「允许图片题」时：开关必须被尊重（图片题此时答不了，属已知取舍） ===');
+{
+	const h = makeHandler(false, false);
+	const r = call(h, {
+		type: 'single',
+		// 真实情况下 env.title / env.options 里是远程 URL（不是 base64）
+		title: 'https://p.ananas.chaoxing.com/star3/origin/a.png',
+		options: 'https://p.ananas.chaoxing.com/star3/origin/b.png\nhttps://p.ananas.chaoxing.com/star3/origin/c.png',
+		// 即使上游已经准备好了图片与截图，关闭开关后也一张都不该发出去
+		images: [DATA_URL_A, DATA_URL_B],
+		screenshot: DATA_URL_C
+	});
+	ok('不抛异常', r.ok, r.err);
+	const user = r.out && r.out[1] && r.out[1].content;
+	ok('user.content 退回纯字符串（不发多模态块）', typeof user === 'string', typeof user);
+	ok('截图也不发（开关优先于 env.screenshot）', typeof user === 'string' && !user.includes('data:image'));
+	ok(
+		'此时选项文本是原始 URL —— 所以图片题必须开启「允许图片题」才有作答可能',
+		String(user).includes('origin/b.png'),
+		String(user).slice(0, 100)
+	);
+}
+
+console.log('\n=== ⑤ 边界：题型为空 / 无选项 / 题干为空 ===');
+{
+	const h = makeHandler(false, true);
+	ok('env 为空对象不抛异常', call(h, {}).ok);
+	ok('无选项不抛异常', call(h, { type: 'single', title: '只有题干', options: '' }).ok);
+	ok(
+		'有图片但无图片题设置时不抛异常',
+		call(h, { type: 'single', title: '', options: '', images: [DATA_URL_A] }).ok
+	);
+}
+
+console.log('\n=== ⑥ 系统提示词必须包含图片选项的作答规则（D3） ===');
+{
+	const wrappers = buildModelAnswererWrappers('opencode-go', 'fake-key-for-test', false, true);
+	const sys = ((wrappers[0] as any).data.messages.handler as string).match(/content: "((?:[^"\\]|\\.)*)"/);
+	const sysText = sys ? JSON.parse('"' + sys[1] + '"') : '';
+	ok('提示词要求图片选项输出 [图片N] 标记', sysText.includes('[图片2]'), sysText.slice(0, 120));
+	ok('提示词声明编号与图片顺序一一对应', sysText.includes('一一对应'));
+	ok('提示词仍保留「输出选项文字」作为主路径', sysText.includes('输出正确选项的完整文字'));
+}
+
+console.log(
+	'\n' +
+		(failures.length === 0 ? '✅ ' : '❌ ') +
+		pass +
+		' 通过   ❌ ' +
+		failures.length +
+		' 失败   共 ' +
+		(pass + failures.length) +
+		' 项'
+);
+if (failures.length) {
+	console.log('\n失败项：');
+	failures.forEach((f) => console.log('  - ' + f));
+	process.exit(1);
+}
diff --git a/tests/cx-videoquiz.test.ts b/tests/cx-videoquiz.test.ts

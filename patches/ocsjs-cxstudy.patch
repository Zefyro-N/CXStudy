@@ -0,0 +1,218 @@
+/**
+ * 视频内弹题：定位与选项选择测试
+ *
+ * 需要浏览器环境（jsdom），由 tsx --import ./tests/setup-browser-env.ts 预加载。
+ *
+ * 守住两处曾真实出错的地方：
+ *   1. 弹题位于**嵌套 iframe** 中——只查当前 document 会一个都找不到，
+ *      表现为弹题闪一下就消失、从未真正作答；
+ *   2. 作答后**必须点击提交按钮**，否则超星不记录作答；
+ *      并且选项匹配要区分单选 / 判断 / 多选（判断题的答案格式与单选不同）。
+ */
+
+import {
+	collectAccessibleDocuments,
+	findVideoQuiz,
+	videoQuizKey,
+	pickVideoQuizOptions,
+	isMultipleChoice,
+	optionInput,
+	readOptionMarks,
+	probeVideoQuizCandidates
+} from '../packages/scripts/src/utils/cx-videoquiz';
+
+let pass = 0;
+const failures: string[] = [];
+
+function ok(name: string, cond: boolean, detail?: string) {
+	if (cond) {
+		pass++;
+		console.log('  ✅ ' + name);
+	} else {
+		failures.push(name + (detail ? ' —— ' + detail : ''));
+		console.log('  ❌ ' + name + (detail ? ' —— ' + detail : ''));
+	}
+}
+
+/** jsdom 未实现 innerText，测试里直接赋属性即可（生产代码读的就是 innerText） */
+function setText(el: any, text: string) {
+	el.innerText = text;
+	return el;
+}
+
+/** 在指定文档里创建一层 iframe 并返回其 contentDocument */
+function addFrame(doc: Document): Document {
+	const f = doc.createElement('iframe');
+	doc.body.appendChild(f);
+	const cd = f.contentDocument;
+	if (!cd) throw new Error('jsdom 未提供 contentDocument');
+	cd.body.innerHTML = '';
+	return cd;
+}
+
+/** 弹题 HTML：两种选项形态各一套 */
+const QUIZ_LABEL_FORM = `
+	<div class="ans-videoquiz">
+		<div class="ans-videoquiz-opt">
+			<label><input type="radio" value="false">错</label>
+			<label><input type="radio" value="true">对</label>
+		</div>
+		<div class="ans-videoquiz-submit">提交</div>
+	</div>`;
+
+const QUIZ_INPUT_FORM = `
+	<div class="ans-videoquiz">
+		<div class="ans-videoquiz-opt"><label><input type="radio" name="ans-videoquiz-opt" value="false">甲</label></div>
+		<div class="ans-videoquiz-opt"><label><input type="radio" name="ans-videoquiz-opt" value="true">乙</label></div>
+		<button id="videoquiz-submit">提交</button>
+	</div>`;
+
+console.log('\n=== ① 弹题位于嵌套 iframe（曾真实出错的场景） ===');
+{
+	const top = document;
+	top.body.innerHTML = '';
+	const inner = addFrame(addFrame(top)); // 两层
+	inner.body.innerHTML = QUIZ_LABEL_FORM;
+	inner.querySelectorAll('label').forEach((l) => setText(l, l.textContent || ''));
+
+	const docs = collectAccessibleDocuments(top);
+	ok('collectAccessibleDocuments 能递归到嵌套 iframe', docs.includes(inner), '共 ' + docs.length + ' 个文档');
+
+	const quiz = findVideoQuiz(top);
+	ok('★ 能从嵌套 iframe 中找到弹题（只查当前 document 会漏掉）', !!quiz);
+	if (quiz) {
+		ok('找到的是最内层文档', quiz.doc === inner);
+		ok('选项数正确（2）', quiz.texts.length === 2, JSON.stringify(quiz.texts));
+		ok('选项文本正确', quiz.texts[0] === '错' && quiz.texts[1] === '对', JSON.stringify(quiz.texts));
+		ok('提交按钮存在（.ans-videoquiz-submit 形态）', !!quiz.submit);
+		ok('readOptionMarks 读到 DOM 标记', readOptionMarks(quiz) === 'false,true', readOptionMarks(quiz));
+		ok('videoQuizKey 可用于去重', videoQuizKey(quiz) === '错|对', videoQuizKey(quiz));
+	}
+}
+
+console.log('\n=== ② 弹题在宿主文档里（另一姿态，不应回归） ===');
+{
+	const top = document;
+	top.body.innerHTML = QUIZ_INPUT_FORM;
+	top.querySelectorAll('label').forEach((l) => setText(l, l.textContent || ''));
+
+	const quiz = findVideoQuiz(top);
+	ok('能找到弹题', !!quiz);
+	if (quiz) {
+		ok('命中 input[name=ans-videoquiz-opt] 形态的选项', quiz.texts.length === 2, JSON.stringify(quiz.texts));
+		ok('提交按钮存在（#videoquiz-submit 形态）', !!quiz.submit);
+	}
+}
+
+console.log('\n=== ③ 没有弹题时不误报 ===');
+{
+	const top = document;
+	top.body.innerHTML = '<div class="video"><video id="video"></video></div>';
+	ok('无弹题时返回 undefined', findVideoQuiz(top) === undefined);
+	ok('collectAccessibleDocuments 至少包含自身', collectAccessibleDocuments(top).length >= 1);
+}
+
+console.log('\n=== ③.5 选题型与 DOM 标记必须从内层 input 读（label 上没有 type/value） ===');
+{
+	const top = document;
+	// label 形态 + checkbox：多选题
+	top.body.innerHTML = `
+		<div class="ans-videoquiz">
+			<div class="ans-videoquiz-opt">
+				<label><input type="checkbox" value="true">甲</label>
+				<label><input type="checkbox" value="false">乙</label>
+				<div class="ans-videoquiz-submit">提交</div>
+			</div>
+		</div>`;
+	top.querySelectorAll('label').forEach((l) => setText(l, l.textContent || ''));
+	const multi = findVideoQuiz(top);
+	ok('找到多选题弹题', !!multi);
+	if (multi) {
+		ok('★ label 形态也能识别出多选（原实现从 label 读 type，恒为单选）', isMultipleChoice(multi) === true);
+		ok('★ readOptionMarks 从内层 input 读到标记', readOptionMarks(multi) === 'true,false', readOptionMarks(multi));
+		ok('optionInput 能拿到内层 input', optionInput(multi.options[0])?.type === 'checkbox');
+	}
+
+	// label 形态 + radio：单选
+	top.body.innerHTML = `
+		<div class="ans-videoquiz">
+			<div class="ans-videoquiz-opt">
+				<label><input type="radio" value="false">错</label>
+				<label><input type="radio" value="true">对</label>
+				<div class="ans-videoquiz-submit">提交</div>
+			</div>
+		</div>`;
+	top.querySelectorAll('label').forEach((l) => setText(l, l.textContent || ''));
+	const single = findVideoQuiz(top);
+	if (single) {
+		ok('label 形态单选不被误判为多选', isMultipleChoice(single) === false);
+	}
+}
+
+console.log('\n=== ③.8 找不到弹题时的宽松诊断（用于低概率问题定位） ===');
+{
+	const top = document;
+	top.body.innerHTML = '<div class="video"><video id="video"></video></div>';
+	ok('页面没有疑似元素时返回 undefined', probeVideoQuizCandidates(top) === undefined);
+
+	// 结构变形：class 名变了，已知选择器匹配不到，但宽松特征能发现
+	top.body.innerHTML = '<div class="ans-videoquiz-new-version"><span>题目变形结构</span></div>';
+	const hint = probeVideoQuizCandidates(top);
+	ok('★ 已知选择器找不到、但宽松特征能发现疑似元素', !!hint, String(hint));
+	ok('诊断信息里带上了 class 与片段 HTML', !!hint && hint.includes('ans-videoquiz-new-version') && hint.includes('HTML='));
+
+	// 嵌套 iframe 里也要能诊断到
+	top.body.innerHTML = '';
+	const deep = addFrame(addFrame(top));
+	deep.body.innerHTML = '<div id="videoquiz-wrapper-2"><span>嵌套里的变形弹题</span></div>';
+	const hint2 = probeVideoQuizCandidates(top);
+	ok('嵌套 iframe 中的疑似元素也能被诊断到', !!hint2 && hint2.includes('videoquiz-wrapper-2'), String(hint2));
+}
+
+console.log('\n=== ④ 选项匹配：单选 / 判断 / 多选 ===');
+{
+	// 单选：原文精确匹配
+	const r1 = pickVideoQuizOptions([['信念']], ['信念', '真理'], false);
+	ok('单选-按选项原文命中', r1.length === 1 && r1[0] === '信念', JSON.stringify(r1));
+
+	// 单选：纯字母兜底
+	const r2 = pickVideoQuizOptions([['B']], ['信念', '真理'], false);
+	ok('单选-按字母兜底命中', r2.length === 1 && r2[0] === '真理', JSON.stringify(r2));
+
+	// 判断题：模型按系统提示词返回「正确/错误」，选项是「对/错」，必须靠极性词映射
+	const r3 = pickVideoQuizOptions([['正确']], ['错', '对'], false);
+	ok('判断题-「正确」映射到含「对」的选项', r3.length === 1 && r3[0] === '对', JSON.stringify(r3));
+
+	const r4 = pickVideoQuizOptions([['错误']], ['错', '对'], false);
+	ok('判断题-「错误」映射到含「错」的选项', r4.length === 1 && r4[0] === '错', JSON.stringify(r4));
+
+	// 多选：字母列表
+	const r5 = pickVideoQuizOptions([['A,C']], ['甲', '乙', '丙'], true);
+	ok('多选-字母列表命中多项', r5.length === 2 && r5[0] === '甲' && r5[1] === '丙', JSON.stringify(r5));
+
+	// 多选：文本列表
+	const r6 = pickVideoQuizOptions([['甲,丙']], ['甲', '乙', '丙'], true);
+	ok('多选-文本列表命中多项', r6.length === 2 && r6.includes('甲') && r6.includes('丙'), JSON.stringify(r6));
+
+	// 匹配不上时必须返回空数组（调用方据此保留弹题、不伪造提交）
+	const r7 = pickVideoQuizOptions([['完全无关的答案']], ['甲', '乙'], false);
+	ok('匹配不上时返回空数组（不随机作答）', r7.length === 0, JSON.stringify(r7));
+
+	ok('空答案返回空数组', pickVideoQuizOptions([], ['甲'], false).length === 0);
+}
+
+console.log(
+	'\n' +
+		(failures.length === 0 ? '✅ ' : '❌ ') +
+		pass +
+		' 通过   ❌ ' +
+		failures.length +
+		' 失败   共 ' +
+		(pass + failures.length) +
+		' 项'
+);
+if (failures.length) {
+	console.log('\n失败项：');
+	failures.forEach((f) => console.log('  - ' + f));
+	process.exit(1);
+}

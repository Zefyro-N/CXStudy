index 0000000..3c90538
--- /dev/null
+++ b/packages/scripts/src/utils/cx-model.ts
@@ -0,0 +1,217 @@
+/**
+ * 本项目锁定的模型答题器。
+ *
+ * 设计约束：
+ *   1. 只允许两个提供商：opencode-go、deepseek 官方
+ *   2. 模型严格锁定为 deepseek-v4.1-flash，界面不提供其他模型的入口
+ *   3. API Key 只存在本地脚本存储中，不写入任何项目文件
+ *
+ * 实现方式：把模型包装成 OCS 原生的 `AnswererWrapper`（通用 HTTP 答题器），
+ * 从而直接复用上游完整的题型 resolver（单选/多选/判断/填空），不重写答题框架。
+ *
+ * 答案格式必须对齐上游 resolver 的匹配阶段（本文件最关键的设计点）：
+ *   - 单选/多选：要求模型返回**选项原文**，命中 `resolveSingle`/`resolveMultiple`
+ *     的阶段 1「归一化精确匹配」。阶段 3 有纯 ABCD 兜底，所以万一回了字母也能用。
+ *   - 判断：必须返回**极性词「正确」/「错误」**。`resolveJudgement` 只认
+ *     CORRECT_WORDS/INCORRECT_WORDS 里的词，返回字母一定失败。
+ *   - 填空：返回答案文本。
+ *
+ * 图片题：消费框架已准备好的 `env.images`（data URL 数组，顺序对应
+ * `env.suggestion_title` / `env.suggestion_options` 里的 `[图片N]` 占位符），
+ * 把 user 消息的 `content` 从字符串改成块数组（text + image_url）。
+ * 因为本文件的数据解析器引用了 `env.images`，上游的
+ * `isAnswererWrappersSupportImageOptimize()` 会自动判定"该配置支持图片题"。
+ */
+import type { AnswererWrapper } from '@ocsjs/core';
+
+/** 锁定的模型：不提供修改入口。V4.1 Flash 原生支持多模态 */
+export const CX_LOCKED_MODEL = 'deepseek-v4.1-flash';
+
+/** 只允许这两个提供商 */
+export const CX_PROVIDERS: Record<
+	string,
+	{ label: string; url: string; extraHeaders: Record<string, string> }
+> = {
+	'opencode-go': {
+		label: 'opencode-go',
+		url: 'https://opencode.ai/inference/go/v1/chat/completions',
+		extraHeaders: {
+			// OpenCode Go 要求自定义 UA + 稳定会话 ID
+			// ${__session} 由 answer.wrapper.handler.ts 的 补丁注入
+			'User-Agent': 'ocs-cxstudy/1.0',
+			'x-opencode-session': '${__session}'
+		}
+	},
+	deepseek: {
+		label: 'deepseek 官方',
+		url: 'https://api.deepseek.com/chat/completions',
+		extraHeaders: {}
+	}
+};
+
+/**
+ * 系统提示词：让模型认清角色，直接给答案。
+ *
+ * 第 1 条与第 6 条是效率的关键——禁止输出推理过程与疑问，
+ * 避免思考模型把 max_tokens 烧在解释上（那会直接导致 content 为空）。
+ */
+const SYSTEM_PROMPT = [
+	'你是一个只负责给出答案的答题助手，服务对象是参加在线课程测验的学生。',
+	'严格遵守以下规则：',
+	'1. 只输出最终答案本身，不要输出解释、推理过程、题号、引号或其他任何前后缀。',
+	'2. 单选题：输出正确选项的完整文字。若正确选项本身就是图片（选项写成 [图片N]），则改为输出该选项的图片标记，例如 [图片2]。',
+	'3. 多选题：输出所有正确选项的完整文字，用英文逗号分隔；若选项是图片，则输出对应的图片标记，例如 [图片2],[图片4]。',
+	'4. 判断题：只输出「正确」或「错误」两个词中的一个。',
+	'5. 填空题：只输出答案文本。',
+	'6. 不确定时给出你认为最可能的一个答案，不要提问、不要要求补充信息、不要拒绝作答。',
+	'7. 题干或选项中的图片会写成 [图片N] 占位符，图片按 N 的顺序（[图片1]、[图片2]…）附在消息末尾，编号与占位符一一对应，请结合图片内容作答。'
+].join('\n');
+
+/**
+ * 生成 `data.messages` 的字段解析器源码。
+ *
+ * OCS 允许 `data` 的每个字段是一个 `{ handler: '<字符串>' }`，该字符串会被
+ * `Function(...)()` 求值成函数并以 `env`（题目上下文）为参数调用。
+ * 因此下面必须以**字符串**形式书写，内部换行写成 \\n（模板字符串转义）。
+ *
+ * @param debug  打开后会把实际发出的 prompt 打到控制台（base64 已截断，避免刷爆控制台）
+ * @param vision 打开后把 `env.images` 作为 image_url 内容块一并发送
+ */
+function makeMessagesHandler(debug: boolean, vision: boolean): string {
+	return `return function (env) {
+	var DEBUG = ${debug ? 'true' : 'false'};
+	var VISION = ${vision ? 'true' : 'false'};
+	try {
+	var kindMap = { single: '单选题', multiple: '多选题', judgement: '判断题', completion: '填空题', line: '连线题', fill: '选词填空题', reader: '阅读理解题' };
+	var kind = kindMap[env.type] || '题目';
+	var letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
+	var images = (VISION && env.images && env.images.length) ? env.images.slice() : [];
+	// 截图兜底生成的整图作为最后一张图附上（它没有对应的 [图片N] 占位符）。
+	var hasShot = !!(VISION && env.screenshot);
+	if (hasShot) { images = images.concat([env.screenshot]); }
+	// 有图片时优先用带 [图片N] 占位符的文本，模型才知道图片对应题干还是某个选项
+	var rawTitle = (images.length && env.suggestion_title) ? env.suggestion_title : (env.title || '');
+	var rawOptions = (images.length && env.suggestion_options) ? env.suggestion_options : (env.options || '');
+	var lines = String(rawOptions).split('\\n').map(function (s) { return s.trim(); }).filter(Boolean);
+	var isChoice = env.type === 'single' || env.type === 'multiple' || env.type === 'judgement';
+	if (isChoice && lines.length === 0) {
+		console.warn('[CXStudy] 选择题未取到任何选项，本题必然答错。题型=' + env.type + '，题干=' + String(rawTitle).slice(0, 60));
+	}
+	var body = lines.length
+		? '题干：' + rawTitle + '\\n选项：\\n' + lines.map(function (t, i) { return letters.charAt(i) + '. ' + t; }).join('\\n')
+		: '题干：' + rawTitle;
+	if (images.length) {
+		body += '\\n\\n本题附带 ' + images.length + ' 张图片' + (hasShot ? '（其中没有对应 [图片N] 的最后一张，是题目区域的整图截图，仅供参考）' : '（按 [图片N] 顺序附后）') + '。';
+	}
+	var userText = '题型：' + kind + '\\n' + body + '\\n\\n答案：';
+	var content;
+	if (images.length) {
+		content = [{ type: 'text', text: userText }];
+		for (var i = 0; i < images.length; i++) {
+			content.push({ type: 'image_url', image_url: { url: images[i] } });
+		}
+	} else {
+		content = userText;
+	}
+	var msgs = [
+		{ role: 'system', content: ${JSON.stringify(SYSTEM_PROMPT)} },
+		{ role: 'user', content: content }
+	];
+	if (DEBUG) {
+		// base64 图片会非常大，截断后再打印
+		console.log('[CXStudy] 发送给模型的 prompt(前2000字符):', JSON.stringify(msgs).slice(0, 2000));
+	}
+	return msgs;
+	} catch (e) {
+		// 防御：构造 prompt 时的任何异常都不应让整道题直接失败。
+		// 降级为纯文本 prompt（文字题仍可作答），并留下可排查的日志。
+		console.warn('[CXStudy] 构造 prompt 失败，已降级为纯文本: ' + (e && e.message ? e.message : e));
+		return [
+			{ role: 'system', content: ${JSON.stringify(SYSTEM_PROMPT)} },
+			{ role: 'user', content: '题型：题目\\n题干：' + String(env.title || '') + '\\n\\n答案：' }
+		];
+	}
+};`;
+}
+
+/**
+ * 生成响应处理器源码。返回 `[题目, 答案]` 二元组（上游要求）。
+ *
+ * 题目字段留空：上游只有 `results[].answer` 参与 resolver 匹配，
+ * `question` 仅用于结果面板展示。
+ *
+ * 兼容思考模型：`content` 为空时（max_tokens 被 reasoning 烧光）从
+ * `reasoning_content` 尾部用正则兜底 —— 从 E:\Code\Estudy 的 askModel() 复刻。
+ */
+function makeResponseHandler(debug: boolean): string {
+	return `return function (res) {
+	var DEBUG = ${debug ? 'true' : 'false'};
+	if (DEBUG) { console.log('[CXStudy] 模型原始响应:', JSON.stringify(res).slice(0, 2000)); }
+	var ch = (res && res.choices && res.choices[0]) || {};
+	var msg = ch.message || {};
+	var text = String(msg.content || '').trim();
+	if (!text) {
+		var rs = String(msg.reasoning_content || '');
+		var cand = rs.slice(-500).toUpperCase().match(/\\b([A-F])\\b/g);
+		text = cand && cand.length ? cand[cand.length - 1] : '';
+	}
+	if (DEBUG) { console.log('[CXStudy] 解析出的答案:', JSON.stringify(text)); }
+	return ['', text];
+};`;
+}
+
+/**
+ * 构建本项目的模型答题器。
+ *
+ * @param provider 提供商 id，只接受 CX_PROVIDERS 的键，其他值一律回退到 opencode-go
+ * @param apiKey   模型 API Key；为空时返回空数组（此时不会发出任何请求）
+ * @param debug    打开后把 prompt 与原始响应打到控制台
+ * @param vision   [M12] 打开后把题目图片作为多模态内容块发给模型
+ */
+export function buildModelAnswererWrappers(
+	provider: string,
+	apiKey: string,
+	debug = false,
+	vision = false
+): AnswererWrapper[] {
+	const key = String(apiKey || '').trim();
+	if (!key) return [];
+
+	// 不存在的提供商一律回退，避免任意 URL 被注入
+	const p = CX_PROVIDERS[provider] || CX_PROVIDERS['opencode-go'];
+
+	return [
+		{
+			name: p.label + ' / ' + CX_LOCKED_MODEL + (vision ? ' / 图片题' : ''),
+			homepage: p.url,
+			url: p.url,
+			method: 'post',
+			type: 'GM_xmlhttpRequest',
+			responseType: 'json',
+			headers: Object.assign(
+				{
+					Authorization: 'Bearer ' + key,
+					'Content-Type': 'application/json'
+				},
+				p.extraHeaders
+			) as Record<string, string>,
+			data: {
+				model: CX_LOCKED_MODEL,
+				messages: { handler: makeMessagesHandler(debug, vision) },
+				// 4096 不够：实测思考模型（v4.1-flash 会输出 reasoning_content）
+				// 会把额度烧在推理上，出现 "finish_reason":"length" 且 content 为空，
+				// 只能从 reasoning 尾部猜字母。4 道题里发生了 1 次。
+				// 提到 8192：这是**上限**而非强制用量，不会平白增加成本。
+				max_tokens: 8192,
+				temperature: 0,
+				stream: false
+			},
+			handler: makeResponseHandler(debug)
+		} as unknown as AnswererWrapper
+	];
+}
+
+/** 是否已配置可用的模型答题器 */
+export function hasModelConfigured(provider: string, apiKey: string): boolean {
+	return buildModelAnswererWrappers(provider, apiKey).length > 0;
+}
diff --git a/packages/scripts/src/utils/cx-screenshot.ts b/packages/scripts/src/utils/cx-screenshot.ts
new file mode 100644
index 0000000..d4ce7a9
--- /dev/null
+++ b/packages/scripts/src/utils/cx-screenshot.ts
@@ -0,0 +1,194 @@
+/**
+ * 截图兜底：把题目区域渲染成图片，交给支持识图的模型。
+ *
+ * 为什么需要它（上游的 env.images 覆盖不到的场景）：
+ *   1. 题面内容不是 <img>，而是 canvas / CSS background / 伪元素渲染的 —— 没有 URL 可抓
+ *   2. 上游抓到了 <img> 但转 base64 失败（跨域 / 防盗链），图片被整体丢弃
+ *   3. 题干文本被 `font-cxsecret` 等混淆字体保护（渲染正确、文本错乱）
+ *
+ * 实现方式：零新依赖 —— 克隆节点 → 把 <img> 的 src 换成已抓到的 data URL
+ * （避免 canvas 被跨域图片污染）→ 内联关键样式 → SVG foreignObject → canvas → dataURL。
+ *
+ * 【已知限制，必须如实告知，不要当成万能方案】
+ *   1. SVG 渲染器**不会加载页面的自定义字体**。所以对「混淆字体」这个场景，
+ *      纯 foreignObject 截图**渲染出来的仍然是回退字体的乱码**，除非把混淆字体本身
+ *      以 base64 @font-face 内嵌进 SVG。上游已有取字体字节的能力
+ *      （font-decrypt 的 `extractFontFromStyle`），但内嵌字体尚未实现。
+ *   2. 内联样式是**白名单近似**，复杂布局（绝对定位、浮层、表格）可能不如原页面。
+ *   3. 若克隆结果里仍残留跨域资源，`toDataURL()` 会抛 SecurityError，函数返回 undefined，
+ *      调用方必须按「没有截图」降级处理。
+ *   4. 图片会显著增加请求体积与 token。因此只在「文本路径明显不够用」时才截图，
+ *      不做无条件截图。
+ */
+
+/** 需要内联的样式白名单（覆盖题目排版的常见需求，故意不求全） */
+const STYLE_KEYS = [
+	'display',
+	'position',
+	'overflow',
+	'box-sizing',
+	'width',
+	'height',
+	'min-width',
+	'max-width',
+	'margin',
+	'padding',
+	'border-top-width',
+	'border-right-width',
+	'border-bottom-width',
+	'border-left-width',
+	'border-style',
+	'border-color',
+	'border-radius',
+	'background-color',
+	'background-image',
+	'background-size',
+	'background-position',
+	'background-repeat',
+	'color',
+	'font-family',
+	'font-size',
+	'font-style',
+	'font-weight',
+	'line-height',
+	'letter-spacing',
+	'text-align',
+	'text-decoration',
+	'text-indent',
+	'vertical-align',
+	'white-space',
+	'word-break',
+	'list-style-type',
+	'list-style-position',
+	'flex-direction',
+	'flex-wrap',
+	'justify-content',
+	'align-items',
+	'gap',
+	'grid-template-columns'
+] as const;
+
+/** 递归把源节点的计算样式内联到克隆节点 */
+function inlineStyles(src: Element, dst: Element) {
+	let cs: CSSStyleDeclaration;
+	try {
+		cs = getComputedStyle(src);
+	} catch (e) {
+		return;
+	}
+	const style = (dst as HTMLElement).style;
+	if (style) {
+		for (const k of STYLE_KEYS) {
+			const v = cs.getPropertyValue(k);
+			if (v && v !== 'none' && v !== 'normal' && v !== 'auto') {
+				try {
+					style.setProperty(k, v);
+				} catch (e) {
+					/* 个别属性非法值，忽略 */
+				}
+			} else if (v) {
+				try {
+					style.setProperty(k, v);
+				} catch (e) {
+					/* 忽略 */
+				}
+			}
+		}
+	}
+	const sChildren = src.children;
+	const dChildren = dst.children;
+	const n = Math.min(sChildren.length, dChildren.length);
+	for (let i = 0; i < n; i++) {
+		inlineStyles(sChildren[i], dChildren[i]);
+	}
+}
+
+/**
+ * 把元素渲染为 PNG data URL。
+ *
+ * @param el     题目根元素（章节测验的 `.TiMu`、作业/考试的 `.questionLi`）
+ * @param toDataUrl 上游的图片转 base64 函数，用于把 <img> 换成 data URL
+ * @param maxWidth  宽度上限，超过则等比缩小（控制体积）
+ */
+export async function captureElementAsDataUrl(
+	el: HTMLElement,
+	toDataUrl: (source: string | HTMLImageElement) => Promise<string>,
+	maxWidth = 900
+): Promise<string | undefined> {
+	try {
+		const w0 = el.offsetWidth || el.clientWidth;
+		const h0 = el.offsetHeight || el.clientHeight;
+		if (!w0 || !h0) return undefined;
+
+		const scale = w0 > maxWidth ? maxWidth / w0 : 1;
+		const w = Math.round(w0 * scale);
+		const h = Math.round(h0 * scale);
+		if (w < 8 || h < 8) return undefined;
+
+		const clone = el.cloneNode(true) as HTMLElement;
+
+		// 1) 把 <img> 的 src 换成 data URL —— 关键步骤：
+		//    否则 SVG 里的跨域图片会让 canvas 被污染，toDataURL() 直接抛 SecurityError
+		const srcImgs = Array.from(el.querySelectorAll('img'));
+		const dstImgs = Array.from(clone.querySelectorAll('img'));
+		for (let i = 0; i < Math.min(srcImgs.length, dstImgs.length); i++) {
+			try {
+				const dataUrl = await toDataUrl(srcImgs[i]);
+				if (dataUrl && dataUrl.indexOf('data:') === 0) {
+					dstImgs[i].setAttribute('src', dataUrl);
+				} else {
+					dstImgs[i].remove();
+				}
+			} catch (e) {
+				dstImgs[i].remove();
+			}
+		}
+
+		// 2) 内联样式（近似）
+		inlineStyles(el, clone);
+
+		// 3) 交给 SVG foreignObject 渲染
+		const xml = new XMLSerializer().serializeToString(clone);
+		const svg =
+			'<svg xmlns="http://www.w3.org/2000/svg" width="' +
+			w +
+			'" height="' +
+			h +
+			'" viewBox="0 0 ' +
+			w0 +
+			' ' +
+			h0 +
+			'">' +
+			'<foreignObject x="0" y="0" width="100%" height="100%">' +
+			'<div xmlns="http://www.w3.org/1999/xhtml" style="width:' +
+			w0 +
+			'px;height:' +
+			h0 +
+			'px;">' +
+			xml +
+			'</div></foreignObject></svg>';
+
+		const svgUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
+		const img = await new Promise<HTMLImageElement>((resolve, reject) => {
+			const im = new Image();
+			im.onload = () => resolve(im);
+			im.onerror = () => reject(new Error('SVG 渲染失败'));
+			im.src = svgUrl;
+		});
+
+		const canvas = document.createElement('canvas');
+		canvas.width = w;
+		canvas.height = h;
+		const ctx = canvas.getContext('2d');
+		if (!ctx) return undefined;
+		ctx.fillStyle = '#ffffff';
+		ctx.fillRect(0, 0, w, h);
+		ctx.drawImage(img, 0, 0, w, h);
+
+		// 4) 跨域残留时此处会抛 SecurityError —— 由外层 try 捕获并返回 undefined
+		return canvas.toDataURL('image/png');
+	} catch (e) {
+		console.warn('[CXStudy] 截图失败，将按无截图降级：' + ((e as any)?.message || e));
+		return undefined;
+	}
+}
diff --git a/packages/scripts/src/utils/cx-videoquiz.ts b/packages/scripts/src/utils/cx-videoquiz.ts
new file mode 100644
index 0000000..2d9137c
--- /dev/null
+++ b/packages/scripts/src/utils/cx-videoquiz.ts
@@ -0,0 +1,200 @@
+/**
+ * 视频内弹题的定位与选项选择。
+ *
+ * 这类题有三个容易踩的坑：
+ *   1. 位置不固定：可能渲染在播放器所在文档里，也可能在**嵌套 iframe** 中，
+ *      只查当前 document 会一个都找不到（表现为弹题闪一下就消失、从未作答）；
+ *   2. 选择器有两套历史形态：选项 `.ans-videoquiz-opt label` 或
+ *      `input[name='ans-videoquiz-opt']`；提交按钮 `#videoquiz-submit` 或
+ *      `.ans-videoquiz-submit`；
+ *   3. 题型不一定是单选，还可能是判断（两个极性选项）或多选（checkbox）。
+ *
+ * 本模块只负责「找到元素」与「决定点哪个选项」，把答案文本匹配交给上游的
+ * 题型算法；作答与提交动作由调用方执行。
+ */
+import { resolveSingle, resolveMultiple, resolveJudgement, isJudgementOptions } from '@ocsjs/core';
+
+/** 弹题在页面中的实际位置与元素 */
+export interface VideoQuiz {
+	/** 弹题元素所在的 document */
+	doc: Document;
+	/** 弹题容器（提交成功后用于隐藏） */
+	container: HTMLElement | null;
+	/** 提交按钮 */
+	submit: HTMLElement | null;
+	/** 可点击的选项元素，与 texts 同序 */
+	options: HTMLElement[];
+	/** 选项文本，与 options 同序 */
+	texts: string[];
+}
+
+/**
+ * 收集 rootDoc 及其所有同源子 iframe 的 document（深度优先）。
+ *
+ * 跨域或尚未加载的 iframe 会被跳过。
+ */
+export function collectAccessibleDocuments(rootDoc: Document): Document[] {
+	const docs: Document[] = [];
+	const seen = new Set<Document>();
+	const walk = (d: Document | null | undefined) => {
+		if (!d || seen.has(d)) return;
+		seen.add(d);
+		docs.push(d);
+		for (const f of Array.from(d.querySelectorAll('iframe'))) {
+			try {
+				walk((f as HTMLIFrameElement).contentDocument);
+			} catch {
+				// 跨域 iframe：忽略
+			}
+		}
+	};
+	walk(rootDoc);
+	return docs;
+}
+
+/** 在单个文档树中查找弹题 */
+export function searchVideoQuiz(root: Document): VideoQuiz | undefined {
+	for (const d of collectAccessibleDocuments(root)) {
+		const labels = Array.from(d.querySelectorAll<HTMLElement>('.ans-videoquiz-opt label'));
+		const inputs = Array.from(d.querySelectorAll<HTMLInputElement>("input[name='ans-videoquiz-opt']"));
+		const options: HTMLElement[] = labels.length ? labels : inputs;
+		const submit = d.querySelector<HTMLElement>('#videoquiz-submit, .ans-videoquiz-submit');
+		if (!options.length && !submit) continue;
+		const texts = options.map((o) => {
+			const holder = o.tagName === 'INPUT' ? ((o.closest('label') as HTMLElement) ?? o.parentElement ?? o) : o;
+			return (holder.innerText || '').trim();
+		});
+		return { doc: d, container: d.querySelector<HTMLElement>('.ans-videoquiz'), submit, options, texts };
+	}
+	return undefined;
+}
+
+/**
+ * 查找弹题：先查给定文档的整棵子树，再退回顶层文档。
+ *
+ * 弹题可能出现在播放器之外的同级框架中，因此单查一棵树不够。
+ */
+export function findVideoQuiz(rootDoc: Document): VideoQuiz | undefined {
+	const roots: Document[] = [rootDoc];
+	try {
+		const topDoc = rootDoc.defaultView?.top?.document;
+		if (topDoc && topDoc !== rootDoc) roots.push(topDoc);
+	} catch {
+		// 顶层跨域：忽略
+	}
+	for (const root of roots) {
+		const quiz = searchVideoQuiz(root);
+		if (quiz) return quiz;
+	}
+	return undefined;
+}
+
+/** 弹题标识（仅用选项），用于去重，避免同一道题反复请求模型 */
+export function videoQuizKey(quiz: VideoQuiz): string {
+	return quiz.texts.join('|').slice(0, 300);
+}
+
+/** 点击选项：label 直接 click；input 需先置 checked 再派发 click 与 change */
+export function clickVideoQuizOption(el: HTMLElement) {
+	if (el.tagName === 'INPUT') {
+		const input = el as HTMLInputElement;
+		input.checked = true;
+		input.click();
+		const view = input.ownerDocument?.defaultView;
+		if (view) input.dispatchEvent(new view.Event('change', { bubbles: true }));
+	} else {
+		el.click();
+	}
+}
+
+/**
+ * 从模型答案中选出要点击的选项文本。
+ *
+ * @param answerGroups 每个答题器返回的答案分组（判断题算法需要分组，其余先拍平）
+ * @param texts        与选项元素同序的选项文本
+ * @param multiple     是否多选（由选项 input 类型判定）
+ * @returns 要点击的选项文本，未匹配到则为空数组
+ */
+export function pickVideoQuizOptions(answerGroups: string[][], texts: string[], multiple: boolean): string[] {
+	const flat = answerGroups.flat();
+	if (multiple) {
+		const r = resolveMultiple(flat, texts);
+		if (r.finish) return ((r.options ?? r.plainOptions) as string[]) ?? [];
+		return [];
+	}
+	// 选项具备判断题性质时交给判断题算法（它认「正确/错误」「对/错」等极性词）
+	if (isJudgementOptions(texts.map((t) => t.trim()))) {
+		const r = resolveJudgement(answerGroups, texts);
+		return r.finish && r.option ? [r.option] : [];
+	}
+	const r = resolveSingle(flat, texts);
+	return r.finish && r.option ? [r.option] : [];
+}
+
+/** 提交成功后隐藏弹题，避免遮挡播放器 */
+export function hideVideoQuiz(quiz: VideoQuiz) {
+	quiz.container?.remove();
+	for (const com of Array.from(quiz.doc.querySelectorAll<HTMLElement>('.x-component-default'))) {
+		com.style.display = 'none';
+	}
+}
+
+/**
+ * 取选项元素对应的 input。
+ *
+ * 选项元素既可能是 `label`（内含 input），也可能是 input 本身，读取
+ * `type` / `value` 前必须先归一化，否则 label 上读到的永远是 undefined。
+ */
+export function optionInput(el: HTMLElement): HTMLInputElement | undefined {
+	if (el.tagName === 'INPUT') return el as HTMLInputElement;
+	const inner = el.querySelector('input');
+	return (inner as HTMLInputElement | null) ?? undefined;
+}
+
+/** 选项是否为多选（checkbox）——决定用多选还是单选匹配算法 */
+export function isMultipleChoice(quiz: VideoQuiz): boolean {
+	return quiz.options.some((o) => optionInput(o)?.type === 'checkbox');
+}
+
+/**
+ * 诊断：按已知选择器找不到弹题时，用宽松特征看看页面里到底有没有类似元素。
+ *
+ * 这类弹题出现概率低、难复现，一旦「该出现时什么都没发生」就无法定位。
+ * 本函数把疑似元素的 class / id / 文本 / 片段 HTML 一并返回，调用方负责去重后再打日志。
+ *
+ * @returns 有疑似元素时返回描述，否则 undefined
+ */
+export function probeVideoQuizCandidates(rootDoc: Document): string | undefined {
+	for (const d of collectAccessibleDocuments(rootDoc)) {
+		let hits: Element[] = [];
+		try {
+			hits = Array.from(
+				d.querySelectorAll('[class*=videoquiz], [id*=videoquiz], [class*=ans-video], [name*=videoquiz]')
+			).slice(0, 3);
+		} catch {
+			continue;
+		}
+		if (hits.length) {
+			const first = hits[0] as HTMLElement;
+			return (
+				'发现 ' + hits.length + ' 个疑似元素；首个 <' + first.tagName.toLowerCase() + '> class=' +
+				JSON.stringify(first.className) + ' id=' + JSON.stringify(first.id) +
+				' 文本=' + JSON.stringify((first.innerText || '').slice(0, 80)) +
+				' HTML=' + (first.outerHTML || '').slice(0, 400)
+			);
+		}
+	}
+	return undefined;
+}
+
+/**
+ * 读取选项上的 DOM 标记（input 的 value 属性）。
+ *
+ * 有资料表明超星曾把正确项标为 `value="true"`；此处只做采集与记录，
+ * **不作为答案来源**，直到在真实弹题上确认其含义。
+ */
+export function readOptionMarks(quiz: VideoQuiz): string {
+	return quiz.options
+		.map((o) => optionInput(o)?.getAttribute('value') ?? '')
+		.join(',');
+}
diff --git a/packages/scripts/src/utils/cx-work-gate.ts b/packages/scripts/src/utils/cx-work-gate.ts
new file mode 100644
index 0000000..910dcbd
--- /dev/null
+++ b/packages/scripts/src/utils/cx-work-gate.ts
@@ -0,0 +1,238 @@
+/**
+ * 作业/考试手动触发闸门 + 预检 + 责任声明。
+ *
+ * 设计约束：
+ *   - 绝不在进入作业/考试页面时自动作答；
+ *   - 必须由用户在看到预检报告后手动点「开始作答」（opt-in，而非倒计时自动开始）；
+ *   - 功能默认关闭；需先勾选责任声明；考试另需单独授权；
+ *   - 使用本功能的风险由用户自行承担（面板与弹窗都要写明）。
+ *
+ * 【不会因为用户授权而放行的两项】
+ *   人脸识别、人机验证码 —— 出现即停手，交由人工完成。这是硬边界。
+ */
+
+const FACE_SELECTORS = ['#fcqrimg', '.chapterVideoFaceMaskDiv'];
+
+/** 验证码特征（与 cx.ts 的 detectCaptcha 保持同一套判据；故意不含通用的 .slider，实测会误报课表组件） */
+const CAPTCHA_HINTS: Array<[string, string]> = [
+	['img[src*="captcha"]', 'captcha 图片'],
+	['img[src*="validate"]', 'validate 图片'],
+	['#yzmImg, .yzmImg, .yzm, .picCode, .refresh-code', '图形验证码（超星常用类名）'],
+	['#verifyCode, #validateCode, #captcha', '验证码元素 id'],
+	['input[name="validateCode"], input[name="verifyCode"], input[name="captcha"]', '验证码输入框'],
+	['.verifyimg, .validateCode, .captcha', '验证码容器类名'],
+	['.geetest_panel, .nc-container, .verify-slider, .slide-verify, .nc_scale', '滑块验证组件']
+];
+
+/** 跨 iframe 深度查询（同源才可访问，跨域静默跳过） */
+function queryAllDeep(selector: string): HTMLElement[] {
+	const out: HTMLElement[] = [];
+	const seen = new Set<Document>();
+	const walk = (doc: Document) => {
+		if (!doc || seen.has(doc)) return;
+		seen.add(doc);
+		try {
+			out.push(...Array.from(doc.querySelectorAll<HTMLElement>(selector)));
+		} catch (e) {
+			/* 忽略 */
+		}
+		try {
+			Array.from(doc.querySelectorAll('iframe')).forEach((f) => {
+				try {
+					if (f.contentWindow && f.contentWindow.document) walk(f.contentWindow.document);
+				} catch (e) {
+					/* 跨域，忽略 */
+				}
+			});
+		} catch (e) {
+			/* 忽略 */
+		}
+	};
+	walk(document);
+	return out;
+}
+
+/** 当前页面是否是考试 */
+export function isExamPage() {
+	return /\/exam\/(preview|test)/.test(location.href);
+}
+
+export interface CxWorkPreCheckResult {
+	ok: boolean;
+	lines: string[];
+	questionCount: number;
+	hasFace: boolean;
+	hasCaptcha: boolean;
+}
+
+/**
+ * 预检：回答“当前界面是否有题目、是否可以进行答题”。
+ * 只读，不点击任何按钮。
+ */
+export function cxWorkPreCheck(): CxWorkPreCheckResult {
+	const lines: string[] = [];
+	let ok = true;
+	const good = (s: string) => lines.push('✅ ' + s);
+	const bad = (s: string) => {
+		lines.push('❌ ' + s);
+		ok = false;
+	};
+	const info = (s: string) => lines.push('ℹ️ ' + s);
+
+	// 1) 题目
+	const questionLi = queryAllDeep('.questionLi');
+	const tiMu = queryAllDeep('.TiMu');
+	const questionCount = questionLi.length || tiMu.length;
+	if (questionCount > 0) {
+		good(
+			'检测到题目 ' +
+				questionCount +
+				' 道' +
+				(questionLi.length ? '（.questionLi，作业/考试）' : '（.TiMu，章节测验）')
+		);
+	} else {
+		bad('未检测到题目容器（.questionLi / .TiMu）—— 可能尚未进入答题界面');
+	}
+
+	// 2) 已提交 / 已完成
+	if (queryAllDeep('.testTit_status_complete').length > 0) {
+		bad('页面标记为已完成（testTit_status_complete），没有可作答的题');
+	}
+
+	// 3) 硬边界：人脸识别
+	const hasFace = FACE_SELECTORS.some((sel) => queryAllDeep(sel).length > 0);
+	if (hasFace) bad('检测到人脸识别：脚本不会绕过，必须先人工完成识别');
+
+	// 4) 硬边界：人机验证
+	let hasCaptcha = false;
+	let captchaBy = '';
+	for (const [sel, by] of CAPTCHA_HINTS) {
+		if (queryAllDeep(sel).length > 0) {
+			hasCaptcha = true;
+			captchaBy = by;
+			break;
+		}
+	}
+	if (!hasCaptcha) {
+		try {
+			const txt = (document.body && document.body.innerText) || '';
+			for (const w of ['请输入验证码', '人机验证', '拖动滑块', '完成验证', '验证码校验']) {
+				if (txt.indexOf(w) >= 0) {
+					hasCaptcha = true;
+					captchaBy = '文案「' + w + '」';
+					break;
+				}
+			}
+		} catch (e) {
+			/* 忽略 */
+		}
+	}
+	if (hasCaptcha) bad('检测到人机验证（' + captchaBy + '）：脚本不会识别或绕过');
+
+	// 5) 考试前置页提示（仅提示，不判定为阻断 —— 这些页面的 DOM 无法可靠识别）
+	if (isExamPage()) {
+		try {
+			const txt = (document.body && document.body.innerText) || '';
+			['考生承诺', '诚信考试', '考试承诺书', '重考须知', '等待开始', '开考时间'].forEach((w) => {
+				if (txt.indexOf(w) >= 0) info('页面文本含「' + w + '」，请确认你已经真正进入答题界面');
+			});
+		} catch (e) {
+			/* 忽略 */
+		}
+	}
+
+	// 6) 图片题提示（帮助用户决定要不要开「允许图片题」）
+	try {
+		const imgs = queryAllDeep('.questionLi img, .TiMu img');
+		if (imgs.length > 0) {
+			info('检测到题目图片 ' + imgs.length + ' 张；若正确率不理想，可开启「允许图片题」与「截图兜底」');
+		}
+	} catch (e) {
+		/* 忽略 */
+	}
+
+	return { ok, lines, questionCount, hasFace, hasCaptcha };
+}
+
+/**
+ * 闸门：只有用户确认后才调用 onStart。
+ *
+ * @param cfg         全局设置对象（由调用方传入，避免本模块反向依赖 common.ts 造成新的循环引用）
+ * @param onStart     真正开始作答的回调
+ * @param interactive 当前是否可用交互弹窗（子 iframe 跨窗口场景为 false）
+ * @param deps        必要的 UI 依赖（由调用方注入，保持本模块不直接依赖 easy-us）
+ */
+export function cxWorkGate(opts: {
+	cfg: any;
+	onStart: () => void;
+	interactive: boolean;
+	deps: {
+		log: (msg: string) => void;
+		warn: (msg: string, duration?: number) => void;
+		confirm: (o: { content: any; confirmButtonText: string; cancelButtonText: string; onConfirm: () => void }) => void;
+		notes: (lines: any[]) => any;
+	};
+}) {
+	const cfg = opts.cfg || {};
+	const { log, warn, confirm, notes } = opts.deps;
+	const isExam = isExamPage();
+	const typeName = isExam ? '考试' : '作业';
+
+	// ---- 授权链：默认关闭 → 责任声明 → 考试单独授权 ----
+	if (!cfg.cxWorkEnabled) {
+		log('[CXStudy] ' + typeName + '自动作答未启用（默认关闭）→ 不启动。');
+		warn('作业/考试自动作答默认关闭。如确有需要，请在「通用-全局设置」开启并确认责任声明。', 10);
+		return;
+	}
+	if (!cfg.cxWorkConsent) {
+		log('[CXStudy] 未确认责任声明 → 拒绝启动。');
+		warn('请先在「通用-全局设置」勾选责任声明，才可使用作业/考试自动作答。', 10);
+		return;
+	}
+	if (isExam && !cfg.cxExamEnabled) {
+		log('[CXStudy] 考试需单独授权 → 拒绝启动。');
+		warn('考试需单独授权：请在「通用-全局设置」勾选「考试单独授权」。', 10);
+		return;
+	}
+
+	// ---- 预检 ----
+	const pre = cxWorkPreCheck();
+	log('[CXStudy] 预检结果（' + typeName + '）：\n' + pre.lines.join('\n'));
+
+	// ---- 硬边界：授权也不放行 ----
+	if (pre.hasFace) {
+		log('[CXStudy] 检测到人脸识别 → 停手，等人工完成。');
+		warn('检测到人脸识别：脚本不会绕过，请人工完成后再手动开始。', 0);
+		return;
+	}
+	if (pre.hasCaptcha) {
+		log('[CXStudy] 检测到人机验证 → 停手。');
+		warn('检测到人机验证：脚本不会识别或绕过，请人工通过后再手动开始。', 0);
+		return;
+	}
+
+	// ---- 子 iframe：交互弹窗不可用，只能让用户去点面板 ----
+	if (!opts.interactive) {
+		log('[CXStudy] 子 iframe 场景弹窗回调不可用 → 需你手动点击面板的开始按钮。');
+		warn('子窗口场景无法弹确认框：请在脚本面板中手动点击开始。', 15);
+		return;
+	}
+
+	// ---- 显式确认 ----
+	confirm({
+		content: notes([
+			'【' + typeName + '】预检结果：',
+			...pre.lines,
+			'',
+			'⚠️ 风险提示：使用本功能的风险（含成绩与学术诚信后果）由你自己承担。',
+			'本脚本不会绕过人脸识别与人机验证码 —— 出现时必须由你人工完成。',
+			pre.ok ? '预检未发现阻断项。' : '预检发现异常项，建议不要开始。'
+		]),
+		cancelButtonText: '取消（推荐）',
+		confirmButtonText: pre.ok ? '开始作答' : '我确认，仍然开始',
+		onConfirm() {
+			log('[CXStudy] 用户已确认，开始作答。');
+			opts.onStart();
+		}
+	});
+}

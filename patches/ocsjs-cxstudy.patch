--- /dev/null
+++ b/tests/setup-browser-env.cjs
@@ -0,0 +1,23 @@
+/**
+ * 测试预加载：在任意业务模块导入前模拟浏览器环境。
+ *
+ * 用法：tsx --require ../tests/setup-browser-env.cjs ../tests/xxx.test.ts
+ *
+ * 为什么必须是独立预加载文件？
+ *   easy-us 在模块顶层执行 `class IElement extends HTMLElement {}`，
+ *   只要任何 import 触发它加载，就会立即引用全局 HTMLElement；而 ES import 会被
+ *   提升到模块顶部，写在 require('browser-env')() 之后并不能保证先执行。
+ *   因此必须由外部预加载，在测试文件被加载之前就装好 HTMLElement 等全局符号。
+ *
+ * 为什么是 .cjs 而不是 .ts？
+ *   用 `tsx --import ./setup-browser-env.ts` 会走 Node 的 ESM 加载器，
+ *   而它不认 .ts 扩展名，直接报 ERR_UNKNOWN_FILE_EXTENSION（tsx 4.x + Node 18 实测）。
+ *   `--require` 走 CommonJS，不受此限制。
+ */
+require('browser-env')();
+
+// @ts-ignore - 构建管线也需要 unsafeWindow
+globalThis.unsafeWindow = {};
+
+// @ts-ignore - GM_xmlhttpRequest 在 Node 下不可用，request() 会降级为 node-fetch
+globalThis.GM_xmlhttpRequest = undefined;
